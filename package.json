{
  "name": "minicode",
  "version": "0.5.0",
  "type": "module",
  "description": "终端里的对话式 LLM 聊天工具: SSE 流式 + 全屏 TUI + 命令行模式 + 项目内缓存, 无工具调用",
  "bin": {
    "minicode": "dist/minicode.mjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "headless": "tsx src/cli.ts --headless",
    "smoke": "tsx test/smoke.ts",
    "typecheck": "tsc --noEmit",
    "smoke:ui": "tsx test/ui-utils.ts",
    "smoke:tui": "tsx test/tui-e2e.ts",
    "build": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3"
  }
}
